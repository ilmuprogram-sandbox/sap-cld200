{
  "name": "incident-management",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^2",
    "jest": "^30.5.2"
  },
  "scripts": {
    "test": "npx jest tests/test.js",
